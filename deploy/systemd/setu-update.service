[Unit]
Description=Deploy the latest published Setu release from main
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=opc
Environment=SETU_HOME=/home/opc/setu
ExecStart=/usr/local/bin/setu-update
TimeoutStartSec=15min
Nice=10
